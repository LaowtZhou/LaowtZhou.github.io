{
  "root": "color:#e8edf2;background:#17212b;font-family:'PingFang SC','Hiragino Sans GB','Microsoft YaHei','Noto Sans CJK SC',sans-serif;padding:32px 0 46px 0;box-sizing:border-box;",
  "p": "margin:0 24px 1.45em 24px;line-height:1.96;font-size:16.5px;color:#e7edf2;text-align:justify;font-family:'PingFang SC','Hiragino Sans GB','Microsoft YaHei','Noto Sans CJK SC',sans-serif;",
  "h1": "margin:1.7em 24px 1.2em 24px;padding:0 0 .72em 0;font-size:28px;line-height:1.35;color:#ffffff;font-weight:800;border-bottom:2px solid #7394ac;font-family:'Arial Black','PingFang SC','Microsoft YaHei',sans-serif;",
  "h2": "margin:2.65em 24px 1.25em 24px;padding:.78em .92em;font-size:21px;line-height:1.42;color:#ffffff;font-weight:800;background:#24384a;border-left:5px solid #78a5c2;font-family:'Arial Black','PingFang SC','Microsoft YaHei',sans-serif;",
  "h3": "margin:2em 24px 1em 24px;padding:0 0 .5em 0;font-size:18px;line-height:1.5;color:#a9c8dd;font-weight:800;border-bottom:1px solid #3d5669;font-family:'PingFang SC','Microsoft YaHei',sans-serif;",
  "h4": "margin:1.55em 24px .8em 24px;font-size:16px;line-height:1.55;color:#c2d2dd;font-weight:700;font-family:'PingFang SC','Microsoft YaHei',sans-serif;",
  "blockquote": "margin:1.9em 24px;padding:1.15em 1.25em;background:#223140;border-left:4px solid #a9c8dd;color:#eef4f7;box-sizing:border-box;font-family:'STKaiti','KaiTi','Kaiti SC','Songti SC',serif;",
  "blockquoteP": "margin:.1em 0;line-height:1.95;font-size:17px;color:#eef4f7;font-weight:400;font-family:'STKaiti','KaiTi','Kaiti SC','Songti SC',serif;",
  "li": "margin:.42em 0;line-height:1.9;color:#e7edf2;font-size:16.5px;font-family:'PingFang SC','Microsoft YaHei',sans-serif;",
  "ul": "margin:.72em 24px 1.18em 52px;padding:0;",
  "ol": "margin:.72em 24px 1.18em 52px;padding:0;",
  "a": "color:#9ed0f0;text-decoration:none;border-bottom:1px solid #56758b;font-family:'PingFang SC','Microsoft YaHei',sans-serif;",
  "code": "padding:2px 6px;background:#2b3d4c;border-radius:3px;color:#c8e7f9;font-size:14px;font-family:Consolas,'SF Mono','Courier New',monospace;word-break:break-word;overflow-wrap:break-word;",
  "pre": "display:block;margin:1.8em 24px 2em 24px;padding:17px 18px;background:#0d141b;border-top:3px solid #78a5c2;border-radius:0;color:#eaf4fa;font-size:14.5px;line-height:1.8;white-space:pre-wrap;word-break:break-word;overflow-wrap:break-word;box-sizing:border-box;font-family:Consolas,'SF Mono','Courier New',monospace;",
  "preCode": "display:block;margin:0;padding:0;background:transparent;border:none;color:inherit;font-size:inherit;line-height:inherit;font-family:inherit;white-space:inherit;word-break:inherit;overflow-wrap:inherit;",
  "img": "display:block;margin:1.55em auto 1.75em;border-radius:0;max-width:100%;height:auto;",
  "hr": "border:none;border-top:1px solid #40596d;margin:2.6em auto;width:46%;",
  "strong": "color:#ffffff;font-weight:800;font-family:'PingFang SC','Microsoft YaHei',sans-serif;",
  "table": "width:calc(100% - 48px);margin:1.8em 24px 2em 24px;border-collapse:collapse;border-top:2px solid #78a5c2;background:#1e2b37;color:#e7edf2;box-sizing:border-box;",
  "th": "padding:.75em .8em;background:#2b4052;border-bottom:1px solid #56758b;color:#ffffff;font-size:15px;line-height:1.65;font-weight:800;text-align:left;vertical-align:top;",
  "td": "padding:.72em .8em;border-bottom:1px solid #344a5c;color:#e7edf2;font-size:15px;line-height:1.75;vertical-align:top;",
  "callout": "margin:1.9em 24px;padding:1.15em 1.25em;background:#223140;border-left:4px solid #a9c8dd;color:#eef4f7;box-sizing:border-box;font-family:'STKaiti','KaiTi','Kaiti SC','Songti SC',serif;"
}
