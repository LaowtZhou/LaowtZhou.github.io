{
  "root": "color:#30233e;background:#f3ecff;font-family:'FangSong','STFangsong','Noto Serif CJK SC','Songti SC',serif;padding:36px 18px 48px 18px;box-sizing:border-box;",
  "p": "margin:0 12px 1.3em 12px;line-height:1.98;font-size:17px;color:#382d46;letter-spacing:.04em;font-family:'FangSong','STFangsong','Noto Serif CJK SC','Songti SC',serif;",
  "h1": "width:300px;max-width:78%;margin:2.15em auto 1.35em auto;padding:0 0 .74em 0;text-align:center;font-size:26px;line-height:1.4;color:#5b2aa8;font-weight:800;letter-spacing:.03em;border-bottom:3px solid #7b48c5;font-family:'Arial Black','PingFang SC','Microsoft YaHei',sans-serif;",
  "h2": "width:auto;max-width:none;margin:2.6em 10px 1.5em 10px;padding:.78em 1em;text-align:center;font-size:24px;line-height:1.4;color:#ffffff;background:#5b2aa8;font-weight:900;letter-spacing:.05em;border:none;font-family:'Arial Black','PingFang SC','Microsoft YaHei',sans-serif;",
  "h3": "margin:1.85em 10px 1em 10px;font-size:18px;line-height:1.6;color:#4a4f58;font-weight:700;letter-spacing:.04em;font-family:'Songti SC','STSong','SimSun','Noto Serif CJK SC',Georgia,'Times New Roman',serif;",
  "h4": "margin:1.45em 10px .75em 10px;font-size:16px;line-height:1.55;color:#4a4f58;font-weight:700;letter-spacing:.04em;font-family:'Songti SC','STSong','SimSun','Noto Serif CJK SC',Georgia,'Times New Roman',serif;",
  "blockquote": "margin:1.8em 0 2em 0;padding:1.2em 1.3em;background:#ffffff;border:2px solid #7b48c5;border-radius:10px;color:#4b326b;box-sizing:border-box;font-family:'FangSong','STFangsong','Songti SC',serif;",
  "blockquoteP": "margin:.05em 0;line-height:1.9;font-size:17px;color:#4c535d;font-style:italic;letter-spacing:.04em;font-family:'Songti SC','STSong','SimSun','Noto Serif CJK SC',Georgia,'Times New Roman',serif;",
  "li": "margin:.32em 0;line-height:1.9;font-size:17px;color:#343a43;letter-spacing:.04em;font-family:'Songti SC','STSong','SimSun','Noto Serif CJK SC',Georgia,'Times New Roman',serif;",
  "ul": "margin:.75em 10px 1.2em 36px;padding:0;",
  "ol": "margin:.75em 10px 1.2em 36px;padding:0;",
  "a": "color:#6e35bd;text-decoration:none;border-bottom:1px dashed #b393df;font-family:'FangSong','STFangsong','Songti SC',serif;",
  "code": "padding:2px 7px;background:#e2d3f7;border-radius:5px;color:#5b2aa8;font-size:15px;line-height:1.5;font-family:'Courier New',Consolas,monospace;letter-spacing:.04em;",
  "pre": "display:block;margin:1.8em 10px 2em 10px;padding:18px 20px;background:#2c1847;border-left:5px solid #a77be0;border-radius:8px;color:#f4eefe;font-size:15px;line-height:1.8;letter-spacing:.04em;white-space:pre-wrap;word-break:break-word;overflow-wrap:break-word;box-sizing:border-box;font-family:'Courier New',Consolas,monospace;",
  "preCode": "display:block;margin:0;padding:0;background:transparent;border:none;color:inherit;font-size:inherit;line-height:inherit;font-family:inherit;white-space:inherit;word-break:inherit;overflow-wrap:inherit;",
  "img": "display:block;width:100%;max-width:100%;height:auto;margin:1.55em auto 1.6em auto;border-radius:10px;",
  "hr": "border:none;border-top:1px solid #cbb8e6;margin:2.6em 10px;",
  "strong": "color:#5b2aa8;font-weight:800;font-family:'FangSong','STFangsong','Songti SC',serif;",
  "table": "width:calc(100% - 20px);margin:1.8em 10px 2em 10px;border-collapse:collapse;border:2px solid #5b2aa8;background:#ffffff;color:#382d46;box-sizing:border-box;font-family:'PingFang SC','Microsoft YaHei',sans-serif;",
  "th": "padding:.72em .78em;background:#5b2aa8;border-bottom:1px solid #5b2aa8;color:#ffffff;font-size:16px;line-height:1.65;font-weight:900;text-align:left;letter-spacing:.04em;",
  "td": "padding:.72em .78em;border-bottom:1px solid #eeeeee;color:#343a43;font-size:16px;line-height:1.75;vertical-align:top;letter-spacing:.04em;",
  "callout": "margin:1.8em 0 2em 0;padding:1.2em 1.3em;background:#ffffff;border:2px solid #7b48c5;border-radius:10px;color:#4b326b;box-sizing:border-box;font-family:'FangSong','STFangsong','Songti SC',serif;"
}
