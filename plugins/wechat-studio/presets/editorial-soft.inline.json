  "h1": "margin:1.9em 26px 1.35em 26px;font-size:29px;line-height:1.42;color:#7f3040;font-weight:700;font-family:'STKaiti','KaiTi','Kaiti SC','Songti SC',serif;",
  "h2": "margin:3.2em 26px 1.5em 26px;padding:.25em 0 .25em .8em;font-size:23px;line-height:1.6;color:#7f3040;font-weight:700;border-left:6px solid #c86d7d;box-shadow:none;font-family:'STKaiti','KaiTi','Kaiti SC','Songti SC',serif;",
