  "blockquote": "margin:2.1em 26px;padding:1.25em 1.35em;background:#f6d9df;border:none;border-radius:18px;color:#6d3540;box-sizing:border-box;font-family:'STKaiti','KaiTi','Kaiti SC','Songti SC',serif;",
  "blockquoteP": "margin:.12em 0;line-height:1.95;font-size:17px;color:#6d3540;font-family:'STKaiti','KaiTi','Kaiti SC','Songti SC',serif;",
  "li": "margin:.3em 0;line-height:1.86;color:#23262b;font-size:17px;font-family:'Songti SC','STSong','SimSun','Noto Serif CJK SC',Georgia,'Times New Roman',serif;",
  "ul": "margin:.7em 24px 1.1em 46px;padding:0;",
  "ol": "margin:.7em 24px 1.1em 46px;padding:0;",
  "a": "color:#a13f55;text-decoration:none;border-bottom:1px solid #d99aa8;font-family:'Songti SC','STSong',serif;",
  "code": "padding:2px 6px;background:#f6d9df;border-radius:5px;color:#8c3045;font-size:15px;font-family:'Courier New',Consolas,monospace;word-break:break-word;overflow-wrap:break-word;",
  "pre": "display:block;margin:2em 26px 2.3em 26px;padding:18px 20px;background:#7f3040;border:none;border-radius:14px;color:#fff7f8;font-size:14.5px;line-height:1.85;white-space:pre-wrap;word-break:break-word;overflow-wrap:break-word;box-sizing:border-box;font-family:'Courier New',Consolas,monospace;",
