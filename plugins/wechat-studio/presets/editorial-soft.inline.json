  "img": "display:block;margin:1.5em auto;border-radius:12px;max-width:100%;height:auto;",
  "hr": "border:none;border-top:1px solid #e7b8c2;margin:3em auto;width:32%;",
  "strong": "color:#8c3045;font-weight:700;font-family:'Songti SC','STSong',serif;",
  "table": "width:calc(100% - 52px);margin:2em 26px 2.3em 26px;border-collapse:collapse;border-top:2px solid #a14c5c;background:#fff7f8;color:#56363c;box-sizing:border-box;font-family:'Songti SC','STSong',serif;",
  "th": "padding:.78em .86em;background:#f6d9df;border-bottom:1px solid #d99aa8;color:#7f3040;font-size:16px;line-height:1.7;font-weight:700;text-align:left;",
  "td": "padding:.76em .86em;border-bottom:1px solid #f0ccd3;color:#56363c;font-size:16px;line-height:1.8;vertical-align:top;",
